# Copy to .env (next to docker-compose.yml) and adjust. docker compose reads it.

# Session signing key: set a long random value, e.g.  openssl rand -hex 32
SECRET_KEY=

# Where the images live on this machine (default: ./datasets next to this file).
# Point it at an existing coco-annotator datasets folder to reuse its images.
#DATASETS_DIR=/home/hunter/coco-annotator/datasets

# Where SAM checkpoints live (default: ./models)
#MODELS_DIR=./models

# Build the image with Segment Anything: none | cpu | cuda
#SAM=none
